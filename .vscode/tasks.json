{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & run tests",
            "type": "shell",
            "command": "make test",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["relative", "${workspaceFolder}"]
            },
            "presentation": { "reveal": "always", "clear": true }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        }
    ]
}
